# UPduino 3.1 - iCE40 UP5K uwg30 package
# Pin Constraints — Clock Cycle Mechanics Experiment
#
# Every pin is a probe point for observing explicit clock behavior.

# RGB LED (hard IP driver)
set_io -nowarn RGB0 A5
set_io -nowarn RGB1 B5
set_io -nowarn RGB2 C5

# --- CLOCK OUTPUTS ---
# True clock waveforms via DDR I/O trick
set_io -nowarn CLK_HF    A1
set_io -nowarn CLK_LF    A2

# --- DIVIDER CHAIN ---
# Each stage is one flip-flop, ÷2 per stage from 12 MHz HFOSC
set_io -nowarn DIV2      A4
set_io -nowarn DIV4      B1
set_io -nowarn DIV8      B3
set_io -nowarn DIV16     C1

# --- CLOCK DOMAIN CROSSING (LFOSC → HFOSC) ---
# Two-FF synchronizer + edge detector
set_io -nowarn SYNC0     C3
set_io -nowarn SYNC1     D1
set_io -nowarn CDC_EDGE  D3

# --- PIPELINE REGISTER CHAIN ---
# 4-stage shift register, data moves 1 stage per HFOSC cycle
set_io -nowarn PIPE0     D5
set_io -nowarn PIPE1     E1
set_io -nowarn PIPE2     E3
set_io -nowarn PIPE3     E4

# --- TIMING MARKERS ---
set_io -nowarn PULSE     E5
set_io -nowarn TICK      F1
set_io -nowarn GATE_EN   F2
set_io -nowarn GATED_D   F4
set_io -nowarn CYCLE_ID  F5
