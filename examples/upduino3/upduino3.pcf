# UPduino 3.1 - iCE40 UP5K uwg30 package
# Pin Constraints for Maximum Observability Experiment
#
# uwg30 GPIO pinout (active pins exposed on headers)
# RGB LED pins (directly to onboard LED via hard IP, directly active from SB_RGBA_DRV)
set_io -nowarn RGB0 A5
set_io -nowarn RGB1 B5
set_io -nowarn RGB2 C5

# --- Observable GPIO ---
# Active output pins for probing with logic analyzer / scope
# Names reflect what signal is routed to each pin

# Directly active clock / heartbeat outputs
set_io -nowarn HCLK_DIV   A1
set_io -nowarn LCLK_OUT   A2

# State machine / control signals
set_io -nowarn FSM0       A4
set_io -nowarn FSM1       B1
set_io -nowarn FSM2       B3

# SPRAM read-back data (active low-order bits)
set_io -nowarn SPRAM_D0   C1
set_io -nowarn SPRAM_D1   C3
set_io -nowarn SPRAM_D2   D1
set_io -nowarn SPRAM_D3   D3

# DSP / MAC16 result bits
set_io -nowarn DSP_D0     D5
set_io -nowarn DSP_D1     E1
set_io -nowarn DSP_D2     E3
set_io -nowarn DSP_D3     E4

# Free counter / general observability
set_io -nowarn CTR0       E5
set_io -nowarn CTR1       F1
set_io -nowarn CTR2       F2
set_io -nowarn CTR3       F4
set_io -nowarn CTR4       F5
